#!/usr/bin/env python3
"""passage-key — convert between human refs and passage keys (SPEC §3).

Usage:
  scripts/passage-key "Romans 8:28-30"     -> ROM.8.28-30
  scripts/passage-key --human ROM.8.28-30  -> Romans 8:28-30
  scripts/passage-key --expand "Mark 4:1-3" -> MRK.4.1 MRK.4.2 MRK.4.3
Exit 0 on success, 1 on errors.
"""

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import lib  # noqa: E402


def main(argv):
    if not argv or "--help" in argv:
        print(__doc__)
        return 0 if "--help" in argv else 1
    mode = "key"
    if argv[0] == "--human":
        mode, argv = "human", argv[1:]
    elif argv[0] == "--expand":
        mode, argv = "expand", argv[1:]
    if not argv:
        print("ERROR: missing argument", file=sys.stderr)
        return 1
    ref = " ".join(argv)
    try:
        if mode == "human":
            lib.parse_key(ref)
            print(lib.human_ref(ref))
        else:
            key = ref if lib.KEY_RE.match(ref) else lib.parse_human_ref(ref)
            lib.parse_key(key)
            if mode == "expand":
                print(" ".join(lib.expand_key(key)))
            else:
                print(key)
    except lib.SpecError as e:
        print("ERROR: %s" % e, file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
